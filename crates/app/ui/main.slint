// SPDX-License-Identifier: GPL-3.0-or-later
import { ScrollView } from "std-widgets.slint";
// Chakra Petch (SIL OFL 1.1, see fonts/OFL.txt) is the face of the whole app.
import "./fonts/ChakraPetch-Regular.ttf";
import "./fonts/ChakraPetch-Medium.ttf";
import "./fonts/ChakraPetch-SemiBold.ttf";
import "./fonts/ChakraPetch-Bold.ttf";

export struct GameRow {
    name: string,
    store: string,
    engine: string,
    api: string,
    exe: string,
    root: string,
    hash: string,
    anticheat: string,
    status: string,
    installed: bool,
    blocked: bool,
    can-install: bool,
    d3d11: bool,
    scan-shaders: bool,
    // First letter, shown when there is no icon.
    initial: string,
    // Steam's 32x32 icon; empty for other stores.
    icon: image,
}

// Last session recorded by the layer for the selected game.
export struct SessionInfo {
    present: bool,
    when: string,
    clean: bool,
    // Headline tiles: value, line under it, and whether it looks healthy.
    fps: string,
    fps-sub: string,
    p99: string,
    p99-sub: string,
    p99-good: bool,
    stutters: string,
    stutters-sub: string,
    stutters-good: bool,
    vram: string,
    vram-sub: string,
    vram-good: bool,
    // Plain-language reading of the session.
    causes: string,
    advice: string,
    // Details.
    frames: string,
    frametime: string,
    created: string,
    // M11: sampled textures bound during play against those alive.
    in-use: string,
    shaders: string,
    display: string,
    note: string,
    safe-mode: bool,
    tiled-tier: int,
    recompressed-textures: int,
    mip-feedback-samples: int,
}

// One line of the Shaders tab; tone 0 neutral, 1 good, 2 warning, 3 bad.
export struct ShaderRow {
    label: string,
    value: string,
    detail: string,
    tone: int,
}

// The Shaders tab starts with a summary from the store indexes.
export struct ShaderState {
    present: bool,
    rows: [ShaderRow],
}

export struct AdvancedOptions {
    max-frame-latency: int,
    d3d11-call-diagnostics: bool,
    present-cpu-sets: bool,
    hybrid: bool,
    mip-residency: bool,
    mip-prediction: bool,
    mip-streaming: bool,
    tiled: bool,
    tiled-hint: string,
    texture-dedup: bool,
    stream-io: int,
    trace: bool,
    texture-quality: int,
    quality-ready: bool,
    quality-status: string,
    compressor: bool,
    mip-feedback: bool,
    feedback-ready: bool,
    prepared-shaders: int,
}

// tessera.ini switches for an installed game.
export struct GameSettings {
    present: bool,
    process: bool,
    residency: bool,
    priority-blocked: bool,
    flip-model: bool,
    rt-recycle: bool,
    ue-streaming: bool,
    fps-options: [string],
    fps-index: int,
    vram-options: [string],
    vram-index: int,
    vram-hint: string,
    advanced: AdvancedOptions,
}

// Neutral greys; colour is kept for state only (ok, warning, error). The
// mosaic tones are greys too.
global Theme {
    out property <color> bg: #161616;
    out property <color> side: #1f1f1f;
    out property <color> surface: #1d1d1d;
    out property <color> raised: #222222;
    out property <color> hover: #ffffff0a;
    out property <color> press: #ffffff12;
    out property <color> line: #2a2a2a;
    out property <color> line-strong: #3a3a3a;
    out property <color> text: #ebebeb;
    out property <color> dim: #a0a0a0;
    out property <color> faint: #808080;
    out property <color> accent: #e4e4e4;
    out property <color> ink: #141414;
    out property <color> ok: #8cc88c;
    out property <color> warn: #e3b25a;
    out property <color> bad: #e06c5a;
    // Mosaic tones.
    out property <color> ochre: #d6d6d6;
    out property <color> sand: #9a9a9a;
    out property <color> umber: #5c5c5c;
    out property <color> slate: #3a3a3a;
    out property <string> display: "Chakra Petch";
    out property <string> mono: "Consolas";
    out property <string> icons: "Segoe Fluent Icons";
    // Windows 11 control fills and stroke.
    out property <color> fill: #ffffff0f;
    out property <color> fill-hover: #ffffff15;
    out property <color> fill-press: #ffffff08;
    out property <color> fill-sunk: #0000001f;
    out property <color> stroke: #ffffff12;
    // Slightly rounded corners, graphite switches, white knobs.
    out property <length> r-ctl: 3px;
    out property <length> r-card: 5px;
    out property <color> graphite: #8e8e93;
    out property <color> knob: #f4f4f4;
    out property <color> ring: #ffffff38;
}

// The mark: a 3x3 patch of mosaic tiles. While busy, the tiles breathe in a
// diagonal wave.
component Mark inherits Rectangle {
    in property <length> tile: 6px;
    in property <length> gap: tile / 3;
    in property <bool> busy;
    width: 3 * tile + 2 * gap;
    height: self.width;
    for c[i] in [Theme.accent, Theme.sand, Theme.ochre, Theme.umber, Theme.accent, Theme.sand, Theme.sand, Theme.slate, Theme.accent]: Rectangle {
        x: Math.mod(i, 3) * (root.tile + root.gap);
        y: Math.floor(i / 3) * (root.tile + root.gap);
        width: root.tile;
        height: root.tile;
        border-radius: root.tile / 4;
        background: c;
        opacity: root.busy ? 0.3 + 0.7 * Math.abs(Math.sin((animation-tick() / 1400ms - (Math.mod(i, 3) + Math.floor(i / 3)) * 0.09) * 180deg)) : 1;
    }
}

// Small uppercase label above a value or a section.
component Caps inherits Text {
    font-family: Theme.display;
    color: Theme.faint;
    font-size: 13px;
    font-weight: 500;
    vertical-alignment: center;
}

// A Segoe Fluent Icons glyph.
component Icon inherits Text {
    font-family: Theme.icons;
    font-size: 15px;
    vertical-alignment: center;
    horizontal-alignment: center;
}

// Windows 11 style button: soft fill, hairline stroke, darker bottom edge,
// arrow cursor. `icon` is a Segoe Fluent Icons code point.
component Btn inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> primary;
    in property <bool> enabled: true;
    // Toolbar style: no fill or stroke until hovered.
    in property <bool> flat;
    callback clicked;
    height: 34px;
    min-width: row.preferred-width;
    preferred-width: self.min-width;
    border-radius: Theme.r-ctl;
    border-width: 1px;
    border-color: root.primary ? Theme.accent.brighter(0.15) : root.flat ? transparent : Theme.stroke;
    background: root.primary
        ? (ta.pressed ? Theme.accent.darker(0.12) : ta.has-hover ? Theme.accent.brighter(0.08) : Theme.accent)
        : (ta.pressed ? Theme.fill-press : ta.has-hover ? Theme.fill-hover : root.flat ? transparent : Theme.fill);
    opacity: root.enabled ? 1 : 0.4;
    animate background { duration: 90ms; }
    animate opacity { duration: 160ms; }
    Rectangle {
        x: 6px;
        y: 0;
        width: parent.width - 12px;
        height: 1px;
        background: root.primary ? #ffffff60 : #ffffff10;
        visible: !ta.pressed && !root.flat;
    }
    row := HorizontalLayout {
        padding-left: root.flat ? 10px : 12px;
        padding-right: root.flat ? 10px : 12px;
        spacing: 8px;
        alignment: center;
        if root.icon != "": Icon {
            text: root.icon;
            color: root.primary ? Theme.ink : ta.pressed ? Theme.dim : Theme.text;
        }
        Text {
            text: root.text;
            color: root.primary ? Theme.ink : ta.pressed ? Theme.dim : Theme.text;
            font-size: 14px;
            font-family: Theme.display;
            font-weight: root.primary ? 700 : 600;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Switch: a graphite track when on, a squared white knob that
// stretches while pressed.
component Toggle inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled;
    width: 44px;
    height: 24px;
    border-radius: 6px;
    opacity: root.enabled ? 1 : 0.45;
    background: root.checked
        ? (ta.has-hover ? Theme.graphite.brighter(0.1) : Theme.graphite)
        : (ta.has-hover ? #ffffff26 : #ffffff1c);
    animate background { duration: 100ms; }
    knob := Rectangle {
        property <length> d: 20px;
        width: ta.pressed ? 25px : self.d;
        height: self.d;
        border-radius: 4px;
        y: (root.height - self.height) / 2;
        x: root.checked ? root.width - self.width - 2px : 2px;
        background: Theme.knob;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #00000066;
        animate x { duration: 120ms; easing: ease-out; }
        animate width { duration: 80ms; }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

component StepArrow inherits Rectangle {
    in property <string> glyph;
    in property <bool> enabled;
    callback clicked;
    width: 32px;
    border-radius: 2px;
    background: ta.pressed && root.enabled ? Theme.fill-press : ta.has-hover && root.enabled ? Theme.fill-hover : transparent;
    animate background { duration: 90ms; }
    Icon {
        text: root.glyph;
        font-size: 12px;
        color: root.enabled ? Theme.dim : Theme.line-strong;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Steps through a short list of choices: < value >.
component Stepper inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index;
    in property <int> max-index: root.model.length - 1;
    in property <bool> enabled: true;
    callback selected;
    width: 180px;
    height: 34px;
    border-radius: Theme.r-ctl;
    background: Theme.fill;
    border-width: 1px;
    border-color: Theme.stroke;
    HorizontalLayout {
        padding: 2px;
        StepArrow {
            glyph: "\u{E76B}";
            enabled: root.enabled && root.current-index > 0;
            clicked => {
                root.current-index -= 1;
                root.selected();
            }
        }
        Text {
            text: root.model[root.current-index];
            font-family: Theme.display;
            font-weight: 600;
            color: Theme.text;
            font-size: 14px;
            horizontal-stretch: 1;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        StepArrow {
            glyph: "\u{E76C}";
            enabled: root.enabled && root.current-index < root.max-index;
            clicked => {
                root.current-index += 1;
                root.selected();
            }
        }
    }
}

// Rounded search field with a soft focus ring.
component SearchField inherits Rectangle {
    callback edited(string);
    height: 34px;
    border-radius: Theme.r-ctl;
    background: #ffffff0c;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.ring : Theme.stroke;
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 10px;
        spacing: 7px;
        Icon { text: "\u{E721}"; font-size: 13px; color: Theme.faint; }
        Rectangle {
            horizontal-stretch: 1;
            Text {
                x: 0;
                height: parent.height;
                text: "Search games";
                color: Theme.faint;
                font-size: 14px;
                vertical-alignment: center;
                visible: input.text == "";
            }
            input := TextInput {
                color: Theme.text;
                font-size: 14px;
                vertical-alignment: center;
                selection-background-color: Theme.accent.with-alpha(0.35);
                edited => { root.edited(self.text); }
            }
        }
    }
}

component Pill inherits Rectangle {
    in property <string> text;
    in property <color> tint;
    height: 26px;
    width: label.preferred-width + 22px;
    border-radius: Theme.r-ctl;
    background: root.tint.with-alpha(0.13);
    label := Text {
        text: root.text;
        color: root.tint;
        font-family: Theme.display;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Message with a thin coloured edge: warnings, safe mode, driver advice.
component Banner inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.warn;
    border-radius: Theme.r-card;
    background: root.tint.with-alpha(0.08);
    border-width: 1px;
    border-color: root.tint.with-alpha(0.16);
    HorizontalLayout {
        padding: 12px;
        padding-left: 14px;
        spacing: 12px;
        Icon { text: "\u{E946}"; font-size: 17px; color: root.tint; }
        Text {
            text: root.text;
            color: Theme.text;
            font-size: 14px;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        @children
    }
}

component Hairline inherits Rectangle {
    height: 1px;
    background: Theme.line;
}

// Vertical divider between toolbar groups.
component ToolSep inherits VerticalLayout {
    alignment: center;
    padding-left: 6px;
    padding-right: 6px;
    Rectangle { width: 1px; height: 22px; background: Theme.line-strong; }
}

// One figure of the session readout: label, value, a short line under it.
component Readout inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <string> sub;
    in property <bool> flagged;
    horizontal-stretch: 1;
    min-width: 130px;
    preferred-width: 130px;
    spacing: 2px;
    Caps { text: root.label; }
    Text {
        text: root.value;
        color: root.flagged ? Theme.warn : Theme.text;
        font-size: 26px;
        font-weight: 600;
        overflow: elide;
    }
    Text { text: root.sub; color: Theme.faint; font-size: 13px; overflow: elide; }
}

// One line of the game list: name, and the layer state when it matters.
component GameItem inherits Rectangle {
    in property <GameRow> game;
    in property <bool> selected;
    callback clicked;
    border-radius: Theme.r-ctl;
    background: root.selected ? #ffffff17 : ta.has-hover ? Theme.hover : transparent;
    Rectangle {
        x: 0;
        width: 3px;
        height: 20px;
        border-radius: 1.5px;
        background: Theme.accent;
        visible: root.selected;
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 4px;
                clip: true;
                background: Theme.fill-hover;
                if root.game.icon.width > 0: Image {
                    source: root.game.icon;
                    image-fit: cover;
                }
                if root.game.icon.width == 0: Text {
                    text: root.game.initial;
                    color: Theme.dim;
                    font-size: 13px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            text: root.game.name;
            color: root.selected || ta.has-hover ? Theme.text : Theme.text.darker(0.12);
            font-size: 14px;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.game.blocked || root.game.installed: Text {
            text: root.game.blocked ? "Anti-cheat" : "On";
            color: root.game.blocked ? Theme.bad : Theme.ok;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Underlined tab, as in the Windows pivot control.
component Tab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    width: label.preferred-width + 26px;
    height: 40px;
    background: ta.pressed ? #ffffff15 : ta.has-hover ? #ffffff0a : transparent;
    animate background { duration: 100ms; easing: ease-out; }
    label := Text {
        text: root.text;
        color: root.active ? Theme.text : ta.has-hover ? Theme.dim.brighter(0.25) : Theme.dim;
        font-size: 14px;
        font-weight: root.active ? 600 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        animate color { duration: 110ms; }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component InfoRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> code;
    spacing: 16px;
    Text { text: root.label; width: 120px; color: Theme.faint; font-size: 13px; }
    Text {
        text: root.value;
        color: Theme.dim.brighter(0.15);
        font-family: root.code ? Theme.mono : "";
        font-size: root.code ? 13px : 14px;
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
}

// A shader check: state bar, name, verdict, then what it means.
component ShaderLine inherits HorizontalLayout {
    in property <ShaderRow> check;
    property <color> tint: root.check.tone == 1 ? Theme.ok : root.check.tone == 2 ? Theme.warn : root.check.tone == 3 ? Theme.bad : Theme.faint;
    spacing: 14px;
    Rectangle { width: 3px; border-radius: 1.5px; background: root.tint; }
    VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            spacing: 16px;
            Text { text: root.check.label; width: 120px; color: Theme.faint; font-size: 13px; vertical-alignment: center; }
            Text {
                text: root.check.value;
                color: root.check.tone == 0 ? Theme.text : root.tint;
                font-size: 17px;
                font-weight: 600;
                horizontal-stretch: 1;
            }
        }
        Text { text: root.check.detail; color: Theme.dim; font-size: 13px; wrap: word-wrap; }
    }
}

// Property grid row: name, control, a short note.
component PropRow inherits VerticalLayout {
    in property <string> label;
    in property <string> help;
    HorizontalLayout {
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 16px;
        Text { text: root.label; width: 190px; color: Theme.text; font-size: 14px; vertical-alignment: center; }
        HorizontalLayout {
            width: 190px;
            alignment: start;
            @children
        }
        Text { text: root.help; color: Theme.faint; font-size: 13px; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
    }
    Hairline { }
}

component OptionSwitch inherits PropRow {
    in property <bool> checked;
    in property <bool> enabled: true;
    callback changed(bool);
    Toggle { checked: root.checked; enabled: root.enabled; toggled => { root.changed(self.checked); } }
}

component Detail inherits Rectangle {
    in property <GameRow> game;
    in property <SessionInfo> session;
    in property <GameSettings> settings;
    in property <ShaderState> shaders;
    in property <bool> busy;
    in-out property <int> tab;
    property <bool> entering-page;
    changed tab => {
        page.content-y = 0px;
        root.entering-page = true;
        page-motion.running = true;
    }
    page-motion := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            self.running = false;
            root.entering-page = false;
        }
    }
    // Steam's key art for the game; empty when there is none.
    in property <image> hero;
    property <bool> has-hero: root.hero.width > 0;
    callback reset-safe-mode();
    callback settings-changed(bool, bool, bool, bool, bool, int, int);
    callback advanced-changed(string, int);
    callback prepare-quality();

    VerticalLayout {
        // The game and what Tessera knows about it at a glance, over its
        // key art when Steam has some.
        Rectangle {
            height: root.has-hero ? 168px : head.preferred-height;
            clip: true;
            if root.has-hero: Image {
                source: root.hero;
                image-fit: cover;
            }
            if root.has-hero: Rectangle {
                background: @linear-gradient(90deg, #161616e6 0%, #16161699 45%, #16161626 100%);
            }
            if root.has-hero: Rectangle {
                background: @linear-gradient(180deg, #16161600 40%, #161616 100%);
            }
        head := VerticalLayout {
            y: parent.height - self.preferred-height;
            height: self.preferred-height;
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 14px;
            spacing: 4px;
            HorizontalLayout {
                spacing: 12px;
                Text {
                    text: root.game.name;
                    color: Theme.text;
                    font-size: 22px;
                    font-weight: 700;
                    overflow: elide;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    if root.game.installed: Pill { text: "Layer on"; tint: Theme.ok; }
                    if root.game.blocked: Pill { text: "Anti-cheat: " + root.game.anticheat; tint: Theme.bad; }
                    if !root.game.installed && !root.game.blocked: Pill { text: "Not installed"; tint: Theme.dim; }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            HorizontalLayout {
                alignment: start;
                spacing: 18px;
                Text { text: root.game.api; color: Theme.dim; font-size: 13px; }
                Text { text: root.game.engine; color: Theme.dim; font-size: 13px; }
                Text { text: root.game.store; color: Theme.dim; font-size: 13px; }
            }
        }
        }

        if root.game.blocked || root.session.safe-mode: VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 12px;
            if root.game.blocked: Banner {
                tint: Theme.bad;
                text: "This game uses anti-cheat. Tessera only reads its files and never installs the layer.";
            }
            if root.session.safe-mode: Banner {
                tint: Theme.bad;
                text: "Safe mode: the layer turned itself off after two runs that did not end cleanly.";
                Btn { text: "Turn back on"; clicked => { root.reset-safe-mode(); } }
            }
        }

        // Tabs.
        VerticalLayout {
            padding-top: 8px;
            Rectangle {
                height: 40px;
                HorizontalLayout {
                    padding-left: 8px;
                    alignment: start;
                    session-tab := Tab { text: "Session"; active: root.tab == 0; clicked => { root.tab = 0; } }
                    shaders-tab := Tab { text: "Shaders"; active: root.tab == 3; clicked => { root.tab = 3; } }
                    settings-tab := Tab { text: "Settings"; active: root.tab == 1; clicked => { root.tab = 1; } }
                    textures-tab := Tab { text: "Textures"; active: root.tab == 4; clicked => { root.tab = 4; } }
                    files-tab := Tab { text: "Files"; active: root.tab == 2; clicked => { root.tab = 2; } }
                }
                Rectangle {
                    x: 12px + (root.tab == 0 ? session-tab.x : root.tab == 3 ? shaders-tab.x :
                        root.tab == 1 ? settings-tab.x : root.tab == 4 ? textures-tab.x : files-tab.x);
                    y: parent.height - self.height;
                    width: (root.tab == 0 ? session-tab.width : root.tab == 3 ? shaders-tab.width :
                        root.tab == 1 ? settings-tab.width : root.tab == 4 ? textures-tab.width : files-tab.width) - 24px;
                    height: 2px;
                    background: Theme.accent;
                    animate x, width { duration: 175ms; easing: ease-out; }
                }
            }
            Hairline { }
        }

        page := ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            content-height: content.preferred-height;
            content := VerticalLayout {
                y: 0px;
                opacity: 1;
                states [
                    entering when root.entering-page : {
                        y: 6px;
                        opacity: 0.78;
                        out { animate y, opacity { duration: 140ms; easing: ease-out; } }
                    }
                ]
                width: page.visible-width;
                padding: 20px;
                padding-top: 16px;
                spacing: 16px;
                alignment: start;

                // Session: the numbers, what they mean, the raw facts.
                if root.tab == 0 && root.session.present: VerticalLayout {
                    spacing: 16px;
                    Text { text: "Last run " + root.session.when; color: Theme.faint; font-size: 13px; }
                    HorizontalLayout {
                        spacing: 24px;
                        Readout { label: "Average FPS"; value: root.session.fps; sub: root.session.fps-sub; }
                        Readout {
                            label: "Slow frames (p99)"; value: root.session.p99; sub: root.session.p99-sub;
                            flagged: !root.session.p99-good;
                        }
                        Readout {
                            label: "Stutters"; value: root.session.stutters; sub: root.session.stutters-sub;
                            flagged: !root.session.stutters-good;
                        }
                        Readout {
                            label: "VRAM"; value: root.session.vram; sub: root.session.vram-sub;
                            flagged: !root.session.vram-good;
                        }
                    }
                    if root.session.causes != "" || root.session.advice != "": HorizontalLayout {
                        spacing: 12px;
                        Rectangle { width: 2px; border-radius: 1px; background: Theme.warn; }
                        VerticalLayout {
                            spacing: 4px;
                            if root.session.causes != "": Text { text: root.session.causes; color: Theme.text; font-size: 14px; wrap: word-wrap; }
                            if root.session.advice != "": Text { text: root.session.advice; color: Theme.dim; font-size: 14px; wrap: word-wrap; }
                        }
                    }
                    Hairline { }
                    VerticalLayout {
                        spacing: 7px;
                        InfoRow { label: "Frames"; value: root.session.frames; }
                        InfoRow { label: "Frame time"; value: root.session.frametime; }
                        InfoRow { label: "Resources"; value: root.session.created; }
                        if root.session.in-use != "": InfoRow { label: "Textures used"; value: root.session.in-use; }
                        if root.session.shaders != "": InfoRow { label: "Shaders"; value: root.session.shaders; }
                        InfoRow { label: "Display"; value: root.session.display; }
                        if root.session.note != "": InfoRow { label: "Notes"; value: root.session.note; }
                    }
                }
                if root.tab == 0 && !root.session.present: Text {
                    color: Theme.dim;
                    font-size: 14px;
                    wrap: word-wrap;
                    text: root.game.blocked
                        ? "No sessions are recorded for anti-cheat games."
                        : root.game.installed
                        ? "No session recorded yet. Play once with the layer on and the results show up here."
                        : root.game.can-install
                        ? "Install the layer and play once. Tessera then shows how the game ran and what can be improved."
                        : "The layer works with 64-bit D3D11 games only, so it cannot be installed here.";
                }

                // Shaders: compiled, covered, damaged, out of date.
                if root.tab == 3: VerticalLayout {
                    spacing: 20px;
                    if !root.shaders.present: Text { text: "No game executable found."; color: Theme.dim; font-size: 14px; }
                    for r in root.shaders.rows: ShaderLine { check: r; }
                }

                // Settings written to tessera.ini; the layer reads them at start.
                if root.tab == 1 && root.settings.present: VerticalLayout {
                    PropRow {
                        label: "FPS limit";
                        help: "Even frame pacing. Steps aside when the game uses Reflex or frame generation.";
                        fps := Stepper {
                            width: 170px;
                            model: root.settings.fps-options;
                            current-index: root.settings.fps-index;
                            selected => { root.settings-changed(process.checked, residency.checked, flip.checked, recycle.checked, ue.checked, fps.current-index, vram.current-index); }
                        }
                    }
                    PropRow {
                        label: "VRAM cap";
                        help: root.settings.vram-hint;
                        vram := Stepper {
                            width: 170px;
                            model: root.settings.vram-options;
                            current-index: root.settings.vram-index;
                            selected => { root.settings-changed(process.checked, residency.checked, flip.checked, recycle.checked, ue.checked, fps.current-index, vram.current-index); }
                        }
                    }
                    PropRow {
                        label: "Memory priority";
                        help: root.settings.priority-blocked
                            ? "Can crash NVIDIA driver 621.14. Leave this off."
                            : "Gives render targets and large buffers higher priority when VRAM runs short.";
                        residency := Toggle {
                            checked: root.settings.residency;
                            enabled: !root.settings.priority-blocked || root.settings.residency;
                            toggled => { root.settings-changed(process.checked, residency.checked, flip.checked, recycle.checked, ue.checked, fps.current-index, vram.current-index); }
                        }
                    }
                    PropRow {
                        label: "Process tweaks";
                        help: "High-resolution timer and moderate priority, game process only.";
                        process := Toggle {
                            checked: root.settings.process;
                            toggled => { root.settings-changed(process.checked, residency.checked, flip.checked, recycle.checked, ue.checked, fps.current-index, vram.current-index); }
                        }
                    }
                    PropRow {
                        label: "Flip presentation";
                        help: "Experimental. Lower latency and G-Sync/FreeSync in borderless windows. Turn off if the screen flickers.";
                        flip := Toggle {
                            checked: root.settings.flip-model;
                            toggled => { root.settings-changed(process.checked, residency.checked, flip.checked, recycle.checked, ue.checked, fps.current-index, vram.current-index); }
                        }
                    }
                    PropRow {
                        label: "Render target reuse";
                        help: "Hands big render targets the game drops back on its next matching create. Cuts hitches in games that recreate them.";
                        recycle := Toggle {
                            checked: root.settings.rt-recycle;
                            toggled => { root.settings-changed(process.checked, residency.checked, flip.checked, recycle.checked, ue.checked, fps.current-index, vram.current-index); }
                        }
                    }
                    PropRow {
                        label: "Unreal texture streaming";
                        help: "Unreal Engine games. Sets the engine's streaming pool to fit this card and streams fewer textures per frame, as players do by hand. Experimental.";
                        ue := Toggle {
                            checked: root.settings.ue-streaming;
                            toggled => { root.settings-changed(process.checked, residency.checked, flip.checked, recycle.checked, ue.checked, fps.current-index, vram.current-index); }
                        }
                    }
                    PropRow {
                        label: "Maximum frame latency";
                        help: "Limits how many frames can be queued ahead. Game default leaves the existing limit alone.";
                        Stepper {
                            width: 170px;
                            enabled: !root.busy;
                            model: ["Game default", "1 frame", "2 frames", "3 frames", "4 frames", "5 frames", "6 frames",
                                    "7 frames", "8 frames", "9 frames", "10 frames", "11 frames", "12 frames",
                                    "13 frames", "14 frames", "15 frames", "16 frames"];
                            current-index: root.settings.advanced.max-frame-latency;
                            selected => { root.advanced-changed("max_frame_latency", self.current-index); }
                        }
                    }
                    OptionSwitch {
                        label: "D3D11 call diagnostics";
                        help: "Records context calls taking at least 1 ms. The session report shows timings and overlap with stutters.";
                        checked: root.settings.advanced.d3d11-call-diagnostics;
                        enabled: !root.busy;
                        changed(value) => { root.advanced-changed("d3d11_call_diagnostics", value ? 1 : 0); }
                    }
                    if root.settings.advanced.hybrid: OptionSwitch {
                        label: "Performance cores";
                        help: "Uses the CPU's performance cores for the thread that presents frames.";
                        checked: root.settings.advanced.present-cpu-sets;
                        enabled: !root.busy;
                        changed(value) => { root.advanced-changed("present_cpu_sets", value ? 1 : 0); }
                    }
                    Text { text: "Changes apply the next time the game starts."; color: Theme.faint; font-size: 13px; }
                }
                if root.tab == 4 && root.settings.present: VerticalLayout {
                    Text { text: "Streaming"; color: Theme.text; font-size: 16px; font-weight: 700; }
                    OptionSwitch {
                        label: "Mip residency";
                        help: root.settings.advanced.tiled-hint;
                        checked: root.settings.advanced.mip-residency;
                        enabled: !root.busy && (root.settings.advanced.tiled || self.checked);
                        changed(value) => { root.advanced-changed("mip_residency", value ? 1 : 0); }
                    }
                    OptionSwitch {
                        label: "Mip prediction";
                        help: "Learns which textures are used together. Helps prefetch and restores likely mips when residency is on.";
                        checked: root.settings.advanced.mip-prediction;
                        enabled: !root.busy;
                        changed(value) => { root.advanced-changed("mip_prediction", value ? 1 : 0); }
                    }
                    OptionSwitch {
                        label: "Split mip uploads";
                        help: "Reuses spare tiles and spreads larger uploads over several frames. Needs mip residency.";
                        checked: root.settings.advanced.mip-streaming;
                        enabled: !root.busy && ((root.settings.advanced.tiled && root.settings.advanced.mip-residency) || self.checked);
                        changed(value) => { root.advanced-changed("mip_streaming", value ? 1 : 0); }
                    }
                    OptionSwitch {
                        label: "Texture deduplication";
                        help: "Shares eligible immutable textures with identical pixels.";
                        checked: root.settings.advanced.texture-dedup;
                        enabled: !root.busy;
                        changed(value) => { root.advanced-changed("texture_dedup", value ? 1 : 0); }
                    }
                    PropRow {
                        label: "File prefetch";
                        help: root.settings.advanced.trace
                            ? "A trace is ready. Prefetch warms previously read file ranges at low priority."
                            : "Select Learn, play once, then refresh to make Prefetch available.";
                        Stepper {
                            width: 170px;
                            model: ["Off", "Learn", "Prefetch"];
                            enabled: !root.busy;
                            max-index: root.settings.advanced.trace ? 2 : 1;
                            current-index: root.settings.advanced.stream-io;
                            selected => { root.advanced-changed("stream_io", self.current-index); }
                        }
                    }
                    Text {
                        text: "Quality"; color: Theme.text; font-size: 16px; font-weight: 700;
                        height: 38px; vertical-alignment: bottom;
                    }
                    PropRow {
                        label: "Texture recompression";
                        help: root.settings.advanced.compressor
                            ? "Capture in one run, then prepare quality with the game closed. Apply uses approved textures."
                            : "The texture compressor is missing. Already prepared textures can still be applied.";
                        Stepper {
                            width: 170px;
                            model: ["Off", "Capture", "Apply"];
                            enabled: !root.busy;
                            max-index: root.settings.advanced.quality-ready ? 2 : 1;
                            current-index: root.settings.advanced.texture-quality;
                            selected => { root.advanced-changed("texture_quality", self.current-index); }
                        }
                    }
                    PropRow {
                        label: "Quality cache";
                        help: root.settings.advanced.quality-status + (root.session.tiled-tier >= 0
                            ? " Last run applied " + root.session.recompressed-textures + "." : "");
                        Btn { text: "Prepare quality"; enabled: !root.busy; clicked => { root.prepare-quality(); } }
                    }
                    OptionSwitch {
                        label: "Mip feedback";
                        help: root.settings.advanced.feedback-ready
                            ? root.settings.advanced.prepared-shaders
                                + (root.settings.advanced.prepared-shaders == 1 ? " shader prepared." : " shaders prepared.")
                                + (root.session.tiled-tier < 0 ? "" : " Last run recorded "
                                  + root.session.mip-feedback-samples
                                  + (root.session.mip-feedback-samples == 1 ? " mip sample." : " mip samples."))
                            : "Records the mips requested by supported shaders. Play once and prepare quality first.";
                        checked: root.settings.advanced.mip-feedback;
                        enabled: !root.busy && (root.settings.advanced.feedback-ready || self.checked);
                        changed(value) => { root.advanced-changed("mip_feedback", value ? 1 : 0); }
                    }
                    Text { text: "Changes apply the next time the game starts."; color: Theme.faint; font-size: 13px; }
                }
                if (root.tab == 1 || root.tab == 4) && !root.settings.present: Text {
                    color: Theme.dim;
                    font-size: 14px;
                    wrap: word-wrap;
                    text: root.game.blocked
                        ? "Settings need the layer, which is never installed in anti-cheat games."
                        : root.game.can-install
                        ? "Install the layer to change these settings."
                        : "The layer works with 64-bit D3D11 games only, so there is nothing to set here.";
                }

                // Files and identity.
                if root.tab == 2: VerticalLayout {
                    spacing: 7px;
                    InfoRow { label: "Layer"; value: root.game.status; }
                    InfoRow { label: "Store"; value: root.game.store; }
                    InfoRow { label: "Engine"; value: root.game.engine; }
                    InfoRow { label: "Executable"; value: root.game.exe; code: true; }
                    InfoRow { label: "Folder"; value: root.game.root; code: true; }
                    InfoRow { label: "Hash (xxh3)"; value: root.game.hash; code: true; }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Tessera";
    preferred-width: 1240px;
    preferred-height: 800px;
    min-width: 1000px;
    min-height: 620px;
    background: Theme.bg;
    default-font-family: Theme.display;

    in property <[GameRow]> games;
    in-out property <int> selected: -1;
    in-out property <int> tab: 0;
    in property <string> status-text;
    in property <bool> busy;
    in property <SessionInfo> session;
    in property <GameSettings> settings;
    in property <ShaderState> shader-state;
    // Key art of the selected game.
    in property <image> hero;
    // S7: driver shader cache advice, empty when all is well.
    in property <string> driver-notice;
    callback refresh();
    callback select(int);
    callback reset-safe-mode(int);
    callback warm-shaders(int);
    callback add-folder();
    callback filter-changed(string);
    callback install(int);
    callback uninstall(int);
    callback open-folder(int);
    callback settings-changed(int, bool, bool, bool, bool, bool, int, int);
    callback advanced-changed(int, string, int);
    callback prepare-quality(int);

    property <length> row-h: 40px;
    property <bool> has-sel: root.selected >= 0 && root.selected < root.games.length;
    property <GameRow> cur: root.games[root.selected];

    VerticalLayout {
        // Command bar: library commands, then the commands for the selected game.
        Rectangle {
            height: 50px;
            background: Theme.side;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 2px;
                alignment: start;
                Btn { flat: true; icon: "\u{E8F4}"; text: "Add game"; enabled: !root.busy; clicked => { root.add-folder(); } }
                Btn { flat: true; icon: "\u{E72C}"; text: "Refresh"; enabled: !root.busy; clicked => { root.refresh(); } }
                ToolSep { }
                Btn {
                    flat: !(root.has-sel && !root.cur.installed && root.cur.can-install);
                    primary: root.has-sel && !root.cur.installed && root.cur.can-install;
                    icon: root.has-sel && root.cur.installed ? "\u{E72C}" : "\u{E896}";
                    text: root.has-sel && root.cur.installed ? "Reinstall layer" : "Install layer";
                    enabled: root.has-sel && root.cur.can-install && !root.cur.blocked && !root.busy;
                    clicked => { root.install(root.selected); }
                }
                Btn {
                    flat: true;
                    icon: "\u{E74D}";
                    text: "Uninstall";
                    enabled: root.has-sel && root.cur.installed && !root.busy;
                    clicked => { root.uninstall(root.selected); }
                }
                Btn {
                    flat: true;
                    icon: "\u{E945}";
                    text: root.has-sel && !root.cur.d3d11 && root.cur.scan-shaders ? "Scan shaders" : "Prepare shaders";
                    enabled: root.has-sel && (root.cur.d3d11 || root.cur.scan-shaders) && !root.busy;
                    clicked => { root.warm-shaders(root.selected); }
                }
                ToolSep { }
                Btn {
                    flat: true;
                    icon: "\u{E838}";
                    text: "Open folder";
                    enabled: root.has-sel;
                    clicked => { root.open-folder(root.selected); }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
        }

        if root.driver-notice != "": VerticalLayout {
            padding: 8px;
            Banner { text: root.driver-notice; }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            // Game list.
            Rectangle {
                width: 300px;
                background: Theme.side;
                VerticalLayout {
                    padding: 8px;
                    spacing: 8px;
                    SearchField { edited(t) => { root.filter-changed(t); } }
                    list := ScrollView {
                        vertical-stretch: 1;
                        content-width: self.visible-width;
                        content-height: root.games.length * root.row-h;
                        for g[i] in root.games: GameItem {
                            x: 0;
                            y: i * root.row-h;
                            width: list.visible-width;
                            height: root.row-h - 2px;
                            game: g;
                            selected: i == root.selected;
                            clicked => {
                                root.selected = i;
                                root.select(i);
                            }
                        }
                    }
                }
                Rectangle { x: parent.width - 1px; width: 1px; background: Theme.line; }
            }

            if root.has-sel: Detail {
                horizontal-stretch: 1;
                game: root.cur;
                hero: root.hero;
                session: root.session;
                settings: root.settings;
                busy: root.busy;
                shaders: root.shader-state;
                tab <=> root.tab;
                reset-safe-mode => { root.reset-safe-mode(root.selected); }
                settings-changed(p, r, fl, rc, u, f, v) => { root.settings-changed(root.selected, p, r, fl, rc, u, f, v); }
                advanced-changed(key, value) => { root.advanced-changed(root.selected, key, value); }
                prepare-quality => { root.prepare-quality(root.selected); }
            }
            if !root.has-sel: VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 16px;
                HorizontalLayout {
                    alignment: center;
                    Mark { tile: 12px; busy: root.busy; }
                }
                Text {
                    text: root.busy ? "Looking for games…" : "Select a game from the list.";
                    color: Theme.dim;
                    font-size: 15px;
                    horizontal-alignment: center;
                }
            }
        }

        // Status bar.
        Rectangle {
            height: 30px;
            background: Theme.side;
            Rectangle { y: 0; height: 1px; background: Theme.line; }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                if root.busy: VerticalLayout {
                    alignment: center;
                    Mark { tile: 3px; gap: 1.5px; busy: true; }
                }
                Text { text: root.status-text; color: Theme.dim; font-size: 13px; vertical-alignment: center; overflow: elide; }
            }
        }
    }
}
