// SPDX-License-Identifier: GPL-3.0-or-later
import { Button, ComboBox, LineEdit, ListView, ScrollView, Switch } from "std-widgets.slint";

export struct GameRow {
    name: string,
    store: string,
    engine: string,
    api: string,
    exe: string,
    root: string,
    hash: string,
    anticheat: string,
    status: string,
    installed: bool,
    blocked: bool,
    can-install: bool,
}

// Last session recorded by the layer for the selected game.
export struct SessionInfo {
    present: bool,
    when: string,
    clean: bool,
    // Headline tiles: value, line under it, and whether it looks healthy.
    fps: string,
    fps-sub: string,
    p99: string,
    p99-sub: string,
    p99-good: bool,
    stutters: string,
    stutters-sub: string,
    stutters-good: bool,
    vram: string,
    vram-sub: string,
    vram-good: bool,
    // Plain-language reading of the session.
    causes: string,
    advice: string,
    // Details.
    frames: string,
    frametime: string,
    created: string,
    display: string,
    note: string,
    safe-mode: bool,
}

// tessera.ini switches for an installed game.
export struct GameSettings {
    present: bool,
    process: bool,
    residency: bool,
    flip-model: bool,
    fps-options: [string],
    fps-index: int,
    vram-options: [string],
    vram-index: int,
    vram-hint: string,
}

global Theme {
    out property <color> bg: #111318;
    out property <color> side: #171a20;
    out property <color> card: #1c2028;
    out property <color> line: #272c36;
    out property <color> text: #e8eaee;
    out property <color> dim: #9aa1ad;
    out property <color> faint: #6b7280;
    out property <color> accent: #6d8cff;
    out property <color> ok: #34d399;
    out property <color> warn: #fbbf24;
    out property <color> bad: #f87171;
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.accent;
    height: 24px;
    width: label.preferred-width + 20px;
    border-radius: 12px;
    background: tint.with-alpha(0.16);
    label := Text {
        text: root.text;
        color: tint.brighter(0.35);
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

component Card inherits Rectangle {
    background: Theme.card;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.line;
}

// Coloured strip with a message: warnings, safe mode, driver advice.
component Banner inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.warn;
    border-radius: 10px;
    background: tint.with-alpha(0.10);
    border-width: 1px;
    border-color: tint.with-alpha(0.35);
    HorizontalLayout {
        padding: 12px;
        spacing: 10px;
        Rectangle { width: 4px; border-radius: 2px; background: root.tint; }
        Text {
            text: root.text;
            color: Theme.text;
            font-size: 13px;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        @children
    }
}

component SectionTitle inherits HorizontalLayout {
    in property <string> text;
    in property <string> sub;
    spacing: 10px;
    Text { text: root.text; color: Theme.text; font-size: 16px; font-weight: 600; vertical-alignment: center; }
    Text { text: root.sub; color: Theme.dim; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
}

component StatTile inherits Card {
    in property <string> label;
    in property <string> value;
    in property <string> sub;
    in property <color> tint: Theme.text;
    horizontal-stretch: 1;
    min-width: 120px;
    VerticalLayout {
        padding: 14px;
        spacing: 4px;
        Text { text: root.label; color: Theme.dim; font-size: 12px; }
        Text { text: root.value; color: root.tint; font-size: 24px; font-weight: 700; overflow: elide; }
        Text { text: root.sub; color: Theme.faint; font-size: 11px; wrap: word-wrap; }
    }
}

component GameItem inherits Rectangle {
    in property <GameRow> game;
    in property <bool> selected;
    callback clicked;
    height: 58px;
    border-radius: 8px;
    background: selected ? Theme.card : ta.has-hover ? #1d2129 : transparent;
    animate background { duration: 120ms; }
    // Accent bar on the selected row.
    Rectangle {
        x: 0; width: 3px; height: 26px;
        border-radius: 2px;
        background: selected ? Theme.accent : transparent;
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 9px; height: 9px; border-radius: 4.5px;
                background: game.blocked ? Theme.bad : game.installed ? Theme.ok : #4b5260;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            Text { text: game.name; color: Theme.text; font-size: 14px; overflow: elide; }
            Text {
                text: game.blocked ? "Anti-cheat · só leitura" : game.installed ? "Camada ativa · " + game.api : game.store + "  ·  " + game.api;
                color: game.blocked ? #fca5a5 : game.installed ? #6ee7b7 : Theme.dim;
                font-size: 11px;
                overflow: elide;
            }
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component InfoRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 16px;
    Text { text: label; width: 110px; color: Theme.dim; font-size: 12px; }
    Text { text: value; color: Theme.text; font-size: 12px; wrap: word-wrap; horizontal-stretch: 1; }
}

// One setting: title and explanation on the left, the control on the right.
component SettingRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> help;
    spacing: 16px;
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 3px;
        alignment: center;
        Text { text: root.title; color: Theme.text; font-size: 13px; font-weight: 600; }
        Text { text: root.help; color: Theme.dim; font-size: 12px; wrap: word-wrap; }
    }
    VerticalLayout {
        alignment: center;
        width: 170px;
        @children
    }
}

component Detail inherits VerticalLayout {
    in property <GameRow> game;
    in property <bool> busy;
    in property <SessionInfo> session;
    in property <GameSettings> settings;
    in-out property <bool> show-files: false;
    callback install();
    callback uninstall();
    callback open-folder();
    callback reset-safe-mode();
    callback settings-changed(bool, bool, bool, int, int);
    padding: 32px;
    spacing: 18px;
    alignment: start;

    // Header: name, tags and the layer actions.
    HorizontalLayout {
        spacing: 16px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 10px;
            Text { text: game.name; font-size: 28px; font-weight: 700; color: Theme.text; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Chip { text: game.store; tint: #a78bfa; }
                Chip { text: game.engine; tint: #60a5fa; }
                Chip { text: game.api; tint: #2dd4bf; }
                if game.installed: Chip { text: "Camada ativa"; tint: Theme.ok; }
                if game.blocked: Chip { text: "Anti-cheat: " + game.anticheat; tint: Theme.bad; }
            }
        }
        VerticalLayout {
            alignment: start;
            HorizontalLayout {
                spacing: 8px;
                if !game.blocked: Button {
                    text: game.installed ? "Reinstalar" : "Instalar camada";
                    primary: !game.installed;
                    enabled: game.can-install && !busy;
                    clicked => { root.install(); }
                }
                if game.installed: Button { text: "Desinstalar"; enabled: !busy; clicked => { root.uninstall(); } }
                Button { text: "Abrir pasta"; clicked => { root.open-folder(); } }
            }
        }
    }

    if game.blocked: Banner {
        tint: Theme.bad;
        text: "Este jogo tem anti-cheat. O Tessera só lê os ficheiros e nunca instala a camada.";
    }
    if session.safe-mode: Banner {
        tint: Theme.bad;
        text: "Modo seguro: a camada desligou-se depois de dois arranques que não terminaram bem.";
        Button { text: "Reativar"; clicked => { root.reset-safe-mode(); } }
    }
    if !game.blocked && !game.installed && !session.present: Banner {
        tint: Theme.accent;
        text: "Instala a camada e joga uma vez: o Tessera mede a sessão (frametimes, stutters, VRAM) e mostra aqui o que pode melhorar.";
    }

    // Last session.
    if session.present: VerticalLayout {
        spacing: 12px;
        SectionTitle { text: "Última sessão"; sub: session.when; }
        HorizontalLayout {
            spacing: 12px;
            StatTile { label: "FPS médio"; value: session.fps; sub: session.fps-sub; }
            StatTile {
                label: "Frames lentos (p99)"; value: session.p99; sub: session.p99-sub;
                tint: session.p99-good ? Theme.text : Theme.warn;
            }
            StatTile {
                label: "Stutters"; value: session.stutters; sub: session.stutters-sub;
                tint: session.stutters-good ? Theme.ok : Theme.warn;
            }
            StatTile {
                label: "VRAM"; value: session.vram; sub: session.vram-sub;
                tint: session.vram-good ? Theme.text : Theme.warn;
            }
        }
        if session.causes != "" || session.advice != "": Card {
            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                if session.causes != "": Text { text: session.causes; color: Theme.text; font-size: 13px; wrap: word-wrap; }
                if session.advice != "": Text { text: session.advice; color: Theme.dim; font-size: 12px; wrap: word-wrap; }
            }
        }
        Card {
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                InfoRow { label: "Frames"; value: session.frames; }
                InfoRow { label: "Frametime"; value: session.frametime; }
                InfoRow { label: "Recursos criados"; value: session.created; }
                InfoRow { label: "Ecrã"; value: session.display; }
                if session.note != "": InfoRow { label: "Nota"; value: session.note; }
            }
        }
    }

    // Optimizations written to tessera.ini; the layer reads them at start.
    if settings.present: VerticalLayout {
        spacing: 12px;
        SectionTitle { text: "Otimizações"; sub: "Aplicam-se no próximo arranque do jogo"; }
        Card {
            VerticalLayout {
                padding: 16px;
                spacing: 16px;
                SettingRow {
                    title: "Limite de FPS";
                    help: "Frames a ritmo certo, menos calor e ruído. Desliga-se sozinho se o jogo usar Reflex ou frame generation.";
                    fps := ComboBox {
                        model: settings.fps-options;
                        current-index: settings.fps-index;
                        selected => { root.settings-changed(process.checked, residency.checked, flip.checked, fps.current-index, vram.current-index); }
                    }
                }
                Rectangle { height: 1px; background: Theme.line; }
                SettingRow {
                    title: "Teto de VRAM";
                    help: settings.vram-hint;
                    vram := ComboBox {
                        model: settings.vram-options;
                        current-index: settings.vram-index;
                        selected => { root.settings-changed(process.checked, residency.checked, flip.checked, fps.current-index, vram.current-index); }
                    }
                }
                Rectangle { height: 1px; background: Theme.line; }
                SettingRow {
                    title: "Apresentação flip (experimental)";
                    help: "Em janela sem bordas, jogos D3D11 antigos passam ao modo flip: menos latência e G-Sync/FreeSync a funcionar. Se vires ecrã preto ou a piscar, desliga.";
                    HorizontalLayout {
                        alignment: end;
                        flip := Switch {
                            checked: settings.flip-model;
                            toggled => { root.settings-changed(process.checked, residency.checked, flip.checked, fps.current-index, vram.current-index); }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.line; }
                SettingRow {
                    title: "Prioridade de memória";
                    help: "Mantém render targets e buffers grandes do jogo na VRAM quando a memória aperta.";
                    HorizontalLayout {
                        alignment: end;
                        residency := Switch {
                            checked: settings.residency;
                            toggled => { root.settings-changed(process.checked, residency.checked, flip.checked, fps.current-index, vram.current-index); }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.line; }
                SettingRow {
                    title: "Ajustes do processo";
                    help: "Timer de alta resolução e prioridade moderada, só no processo do jogo.";
                    HorizontalLayout {
                        alignment: end;
                        process := Switch {
                            checked: settings.process;
                            toggled => { root.settings-changed(process.checked, residency.checked, flip.checked, fps.current-index, vram.current-index); }
                        }
                    }
                }
            }
        }
    }

    // Files: collapsed by default, they matter only when something is wrong.
    VerticalLayout {
        spacing: 10px;
        HorizontalLayout {
            alignment: start;
            Text {
                text: (root.show-files ? "Esconder" : "Mostrar") + " ficheiros e estado da camada";
                color: files-ta.has-hover ? Theme.text : Theme.dim;
                font-size: 13px;
                files-ta := TouchArea { clicked => { root.show-files = !root.show-files; } }
            }
        }
        if root.show-files: Card {
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                InfoRow { label: "Executável"; value: game.exe; }
                InfoRow { label: "Pasta"; value: game.root; }
                InfoRow { label: "Hash (xxh3)"; value: game.hash; }
                InfoRow { label: "Camada"; value: game.status; }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Tessera";
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 900px;
    min-height: 560px;
    background: Theme.bg;
    default-font-family: "Segoe UI Variable Text";

    in property <[GameRow]> games;
    in-out property <int> selected: -1;
    in property <string> status-text;
    in property <bool> busy;
    in property <SessionInfo> session;
    in property <GameSettings> settings;
    // S7: driver shader cache advice, empty when all is well.
    in property <string> driver-notice;
    callback refresh();
    callback select(int);
    callback reset-safe-mode(int);
    callback add-folder();
    callback filter-changed(string);
    callback install(int);
    callback uninstall(int);
    callback open-folder(int);
    callback settings-changed(int, bool, bool, bool, int, int);

    HorizontalLayout {
        Rectangle {
            width: 320px;
            background: Theme.side;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        Text { text: "Tessera"; font-size: 22px; font-weight: 700; color: Theme.text; }
                        Text { text: "Menos stutter, menos VRAM"; font-size: 11px; color: Theme.faint; }
                    }
                    VerticalLayout {
                        alignment: center;
                        Button { text: "Atualizar"; enabled: !root.busy; clicked => { root.refresh(); } }
                    }
                }
                LineEdit {
                    placeholder-text: "Procurar jogos…";
                    edited(t) => { root.filter-changed(t); }
                }
                ListView {
                    vertical-stretch: 1;
                    for g[i] in root.games: GameItem {
                        game: g;
                        selected: i == root.selected;
                        clicked => { root.selected = i; root.select(i); }
                    }
                }
                Button { text: "Adicionar pasta de jogo…"; clicked => { root.add-folder(); } }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            if root.driver-notice != "": VerticalLayout {
                padding: 16px;
                padding-bottom: 0px;
                Banner { text: root.driver-notice; }
            }
            if root.selected >= 0 && root.selected < root.games.length: ScrollView {
                vertical-stretch: 1;
                Detail {
                    width: parent.visible-width;
                    game: root.games[root.selected];
                    busy: root.busy;
                    session: root.session;
                    settings: root.settings;
                    reset-safe-mode => { root.reset-safe-mode(root.selected); }
                    install => { root.install(root.selected); }
                    uninstall => { root.uninstall(root.selected); }
                    open-folder => { root.open-folder(root.selected); }
                    settings-changed(p, r, fl, f, v) => { root.settings-changed(root.selected, p, r, fl, f, v); }
                }
            }
            if root.selected < 0 || root.selected >= root.games.length: VerticalLayout {
                vertical-stretch: 1;
                alignment: center;
                spacing: 8px;
                Text {
                    text: root.busy ? "A procurar jogos…" : "Escolhe um jogo à esquerda";
                    color: Theme.text;
                    font-size: 17px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Verde: camada ativa · Cinzento: por instalar · Vermelho: anti-cheat (só leitura)";
                    color: Theme.dim;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
            }
            Rectangle {
                height: 30px;
                background: Theme.side;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    Text { text: root.status-text; color: Theme.dim; font-size: 12px; vertical-alignment: center; overflow: elide; }
                }
            }
        }
    }
}
